<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Нажатое состояние -->
    <item android:state_pressed="true" android:drawable="@drawable/ic_sort_desc"/>

    <!-- Выбранное состояние (asc) - стрелка ВВЕРХ -->
    <item android:state_checked="true" android:state_pressed="false" android:drawable="@drawable/ic_sort_asc"/>


    <!-- Состояние по умолчанию (desc) - стрелка ВНИЗ -->
    <item android:drawable="@drawable/ic_sort_desc"/>

</selector>